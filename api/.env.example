# Copy to .env for local development. On cPanel, set these in the Node.js app form.
# Never commit a real .env file.

NODE_ENV=development
PORT=4000

# Public address of the site, and where the API is mounted.
APP_BASE_URL=http://localhost:3000
API_BASE_PATH=/api
# Comma-separated list of origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the app (1 on cPanel/Passenger, 0 locally).
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ssctc_shop
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=5

# Staff sessions
SESSION_COOKIE_NAME=ssctc_sid
SESSION_COOKIE_DOMAIN=
SESSION_HOURS=12
SESSION_IDLE_HOURS=2

# Customer portal sessions
PORTAL_COOKIE_NAME=ssctc_cid
PORTAL_SESSION_DAYS=7

BCRYPT_COST=12

BACKUP_DIR=
# Secret for the nightly cron job (see DEPLOYMENT_PLAN.md §5). At least 32 characters.
BACKUP_CRON_KEY=
# Google Drive copy of each backup. Run `npm run gdrive-setup` on your PC; it prints these four.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# The mailbox that sends the Owner's password codes (port 465 = SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by `npm run seed` to create the first Owner account, then remove them.
OWNER_NAME=
OWNER_USERNAME=
OWNER_PASSWORD=
