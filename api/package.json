{
  "name": "ssctc-shop-api",
  "version": "0.1.0",
  "private": true,
  "description": "SSCTC Shop — Express API",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "node scripts/migrate.js",
