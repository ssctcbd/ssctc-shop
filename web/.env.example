# Build-time and public: these values end up in the files sent to browsers.
# Never put a secret here.

# Local development (API runs separately on port 4000): copy to .env.development.local
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production build (site and API on the same subdomain): this is the default
# when the variable is not set, so no file is needed.
# NEXT_PUBLIC_API_URL=/api/v1
